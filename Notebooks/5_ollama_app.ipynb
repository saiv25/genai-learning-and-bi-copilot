   ],
   "source": [
    "\n",
    "from langchain_ollama import ChatOllama\n",
    "\n",
    "llm = ChatOllama(model=\"gemma3:1b\")\n",
    "\n",
    "response = llm.invoke(\"Hello, how are you?\")\n",
    "print(response.content)\n"
   ]
  }
